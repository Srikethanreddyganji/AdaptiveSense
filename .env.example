# Backend (Spring Boot)
DATABASE_URL=jdbc:postgresql://localhost:5432/adaptivesense
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters
JWT_EXPIRATION_MS=86400000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_CONNECT_TIMEOUT=5s
OLLAMA_READ_TIMEOUT=180s
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=220
OLLAMA_NUM_THREAD=0
OLLAMA_KEEP_ALIVE=30m
OLLAMA_REQUEST_QUEUE_TIMEOUT=90s
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_INTERNAL_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
ENVIRONMENT=development
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
AUDIO_MAX_SIZE_BYTES=10485760
AUDIO_MAX_REQUEST_SIZE_BYTES=11534336
AUDIO_MAX_DURATION_SECONDS=60
PORT=8081

# Python AI service
# AI_SERVICE_INTERNAL_KEY must match the backend when set
# ENVIRONMENT=production requires a configured AI_SERVICE_INTERNAL_KEY
# MAX_AUDIO_BYTES=10485760
# MAX_AUDIO_SECONDS=60
# MIN_AUDIO_SECONDS=0.3
# FFMPEG_PATH=C:\Program Files\ffmpeg\bin\ffmpeg.exe
# WHISPER_MODEL=openai/whisper-tiny
# Local model loading is offline by default; download the configured assets before first startup.
# VOICE_EMOTION_LOCAL_FILES_ONLY=true
# WHISPER_LOCAL_FILES_ONLY=true
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# AI_TORCH_THREADS=2

# Frontend (Vite)
# VITE_API_URL=http://127.0.0.1:8081/api
